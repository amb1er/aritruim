# ══════════════════════════════════════════════════════════════════════════════
# FUNDING RATE ARBITRAGE BOT — КОНФИГУРАЦИЯ
# Скопируй этот файл в .env и заполни значения
# НИКОГДА не коммить .env в git
# ══════════════════════════════════════════════════════════════════════════════

# ── Режим работы ──────────────────────────────────────────────────────────────
# dry_run  = только наблюдение, ордера не отправляются (старт здесь)
# paper    = виртуальный портфель с реальными ценами
# live     = пока заблокирован: требуется подтверждение исполнений и платежей Nado
BOT_MODE=dry_run

# ── Hyperliquid ───────────────────────────────────────────────────────────────
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=
# Multi-instance: address:credential:transport_url. Последнее поле может быть пустым.
HYPERLIQUID_ACCOUNTS=0xAAA:0xpk1:http://user:pass@proxy1.example:8080,0xBBB:0xpk2:socks5://proxy2.example:1080
# Старый формат поддерживается, если HYPERLIQUID_ACCOUNTS пуст.
HYPERLIQUID_WALLETS=
HYPERLIQUID_PRIVATE_KEYS=
HYPERLIQUID_PROXIES=
# Для сравнения с production Nado используем production рыночные данные.
# В dry_run/paper реальные ордера не отправляются.
HYPERLIQUID_TESTNET=false
# Base URL (не менять без причины)
HYPERLIQUID_REST_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_SPOT_ENABLED=true
HYPERLIQUID_SPOT_MAKER_FEE=0.0004
HYPERLIQUID_SPOT_TAKER_FEE=0.0007

# ── Entropy (Hyperliquid HIP-3, dex id io) ───────────────────────────────────
ENTROPY_ENABLED=true
# Farming multi-instance: address:credential:transport_url.
# Если строка пустая, для обратной совместимости используются HYPERLIQUID_ACCOUNTS.
ENTROPY_ACCOUNTS=0xEEE:0xpk5:http://user:pass@proxy5.example:8080,0xFFF:0xpk6:
ENTROPY_DEX=io
# Явные консервативные допущения для оценки paper P&L.
ENTROPY_MAKER_FEE=0.0003
ENTROPY_TAKER_FEE=0.0009

# Lighter domain deployed on Robinhood Chain (public data and paper only).
LIGHTER_ROBINHOOD_ENABLED=true
# Optional farming instances: address:credential:transport_url.
# Public paper data works without this field; configure it for per-instance proxies.
LIGHTER_ROBINHOOD_ACCOUNTS=0x777:credential7:http://user:pass@proxy11.example:8080,0x888:credential8:
LIGHTER_ROBINHOOD_REST_URL=https://api.rh.lighter.xyz
LIGHTER_ROBINHOOD_WS_URL=wss://api.rh.lighter.xyz/stream

# Arcus perpetuals on Robinhood Chain (public data and paper only).
ARCUS_ENABLED=true
# Optional farming instances: address:credential:transport_url.
ARCUS_ACCOUNTS=0x999:credential9:http://user:pass@proxy12.example:8080,0xAAA:credential10:
ARCUS_REST_URL=https://api.arcus.xyz
ARCUS_WS_URL=wss://api.arcus.xyz/v1/ws

# Extended Exchange on Starknet (public data and paper only).
EXTENDED_ENABLED=true
EXTENDED_REST_URL=https://api.starknet.extended.exchange
EXTENDED_WS_URL=wss://api.starknet.extended.exchange
EXTENDED_MAKER_FEE=0
EXTENDED_TAKER_FEE=0.00025

# Hibachi (public data and paper only).
HIBACHI_ENABLED=true
HIBACHI_API_URL=https://api.hibachi.xyz
HIBACHI_DATA_URL=https://data-api.hibachi.xyz
HIBACHI_TAKER_FEE=0.00045

# Polymarket Perps (public data and paper only).
POLYMARKET_PERPS_ENABLED=true
# address = Polymarket wallet, credential = EVM private key.
# Официальный live SDK пока не поддерживает индивидуальный transport proxy.
POLYMARKET_PERPS_ACCOUNTS=0x111:credential1:http://user:pass@proxy7.example:8080,0x222:credential2:
POLYMARKET_PERPS_REST_URL=https://api.perpetuals.polymarket.com
# Fallback for categories omitted by the public fee schedule.
POLYMARKET_PERPS_MAKER_FEE=0.000125
POLYMARKET_PERPS_TAKER_FEE=0.0004

# TxFlow (public data and paper only).
TXFLOW_ENABLED=true
# Credential сохраняется для инстанса; реальные ордера пока отключены.
TXFLOW_ACCOUNTS=0x333:credential3:http://user:pass@proxy9.example:8080,0x444:credential4:
TXFLOW_REST_URL=https://api.txflow.com
TXFLOW_WS_URL=wss://api.txflow.com/ws
TXFLOW_API_VERSION=2026-02-04
TXFLOW_MAKER_FEE=0.00015
TXFLOW_TAKER_FEE=0.00045

# Farming: margin allocated to each leg and exposure multiplier.
# 50 USD margin at 3x creates a 150 USD long and a 150 USD short.
FARMING_ENABLED=true
# One group per wallet index; venues use | and wallet groups use ;.
# Example: wallet 0 monitors Entropy/Polymarket/Arcus, wallet 1 monitors Nado/TxFlow/Lighter.
FARMING_INSTANCE_VENUES=entropy|polymarket_perps|arcus;nado|txflow|lighter_robinhood
FARMING_MODE=paper
# Live requires an explicit second switch and starts only with 1x / one open pair.
FARMING_LIVE_ACKNOWLEDGE_RISK=false
FARMING_LIVE_PREFLIGHT_ONLY=true
FARMING_LIVE_BALANCE_BUFFER=2
FARMING_LIVE_MAX_NOTIONAL_USD=10
FARMING_LIVE_SQLITE_PATH=data/farming.live.db
FARMING_NOTIONAL_USD=50
FARMING_LEVERAGE=3
# Historical filter learns by symbol + directed venue pair. Losing patterns are
# paused for 24 hours, then admitted for one new probe instead of being banned forever.
FARMING_HISTORY_MIN_COMBO_TRADES=2
FARMING_HISTORY_MIN_ROUTE_TRADES=4
FARMING_HISTORY_BLOCK_SEC=86400
FARMING_HISTORY_TAIL_LOSS_RETURN=0.002

# ── Nado (Ink L2) ─────────────────────────────────────────────────────────────
NADO_WALLET_ADDRESS=
NADO_PRIVATE_KEY=
# Multi-instance: address:credential:transport_url. Последнее поле может быть пустым.
NADO_ACCOUNTS=0xCCC:0xpk3:http://user:pass@proxy3.example:8080,0xDDD:0xpk4:
# Старый формат поддерживается, если NADO_ACCOUNTS пуст.
NADO_WALLETS=
NADO_PRIVATE_KEYS=
NADO_PROXIES=
NADO_REST_URL=https://gateway.prod.nado.xyz/v1
NADO_ARCHIVE_URL=https://archive.prod.nado.xyz/v1
NADO_WS_URL=wss://gateway.prod.nado.xyz/v1/ws
NADO_SUB_URL=wss://gateway.prod.nado.xyz/v1/subscribe

# ── Символы ───────────────────────────────────────────────────────────────────
# auto = автоматически найти все общие символы между биржами
# Или явный whitelist через запятую: BTC,ETH,SOL,BNB,XRP
SYMBOLS=auto
# Исключить из авто-дискавери (мемкоины, низколиквидные)
SYMBOLS_BLACKLIST=

# ══════════════════════════════════════════════════════════════════════════════
# РАЗМЕР ПОЗИЦИЙ И ПЛЕЧО
# ══════════════════════════════════════════════════════════════════════════════

# Максимальный размер ОДНОЙ НОГИ как % от суммарного капитала (0.10 = 10%)
MAX_POSITION_PCT=0.10
MIN_POSITION_USD=25
POSITION_SIZING_ITERATIONS=12
POSITION_SIZE_HEADROOM=0.85
EXIT_LIQUIDITY_MULTIPLIER=2
MAX_DAILY_LOSS_USD=100
LIQUIDITY_REJECT_LIMIT=3
LIQUIDITY_COOLDOWN_SEC=120

# Кредитное плечо для обеих ног
# 1.0 = без плеча, 2.0 = 2x, 3.0 = 3x (рекомендуется ≤3x для этой стратегии)
LEVERAGE=1.0

# Максимальное количество одновременно открытых арбитражных пар
MAX_OPEN_PAIRS=5

# Начальный виртуальный баланс НА КАЖДОЙ бирже; ключи в paper не нужны.
PAPER_BALANCE_USD=10000

# Горизонт оценки окупаемости входа; это предположение, не гарантия дохода.
EXPECTED_HOLD_HOURS=12
MAX_SIGNAL_AGE_SEC=60

# ══════════════════════════════════════════════════════════════════════════════
# ПОРОГИ ВХОДА
# ══════════════════════════════════════════════════════════════════════════════

# Минимальный спред funding rate для открытия позиции
# Единицы: ставка за ЧАС для обеих бирж. Старые пороги нужно пересмотреть.
MIN_FUNDING_SPREAD=0.0001

# Минимальный net P&L после комиссий и проскальзывания (в долях от notional)
# Доход за EXPECTED_HOLD_HOURS минус комиссии и оценка проскальзывания входа/выхода.
MIN_NET_PNL_AFTER_FEES=0.00001
ENTRY_COST_COVERAGE=1.10
BASIS_RISK_BUFFER_PCT=0.0005
MAX_ENTRY_PAYBACK_FRACTION=0.50
MAX_SLIPPAGE=0.0035

# Максимальная оценка проскальзывания для входа (0.001 = 0.1%)

# Глубина стакана для оценки проскальзывания (в USD notional)
SLIPPAGE_CHECK_NOTIONAL=10000

# ══════════════════════════════════════════════════════════════════════════════
# ВЫХОД ИЗ ПОЗИЦИИ
# ══════════════════════════════════════════════════════════════════════════════

# Держим до схлопывания спреда: закрыть когда спред упал ниже этого порога
# Единицы: ставка за ЧАС, как у MIN_FUNDING_SPREAD.
EXIT_FUNDING_SPREAD=0.00005

# Принудительное закрытие через N часов (защита от зависших позиций)
MAX_HOLD_HOURS=72

# ══════════════════════════════════════════════════════════════════════════════
# РИСК-МЕНЕДЖМЕНТ
# ══════════════════════════════════════════════════════════════════════════════

# Закрыть позицию если ноги разошлись по цене более чем на N% (0.02 = 2%)
DELTA_STOP_LOSS_PCT=0.02

# Circuit breaker: пауза после N последовательных неудачных ордеров
CIRCUIT_BREAKER_FAILURES=3

# Начальная пауза circuit breaker в секундах (удваивается с каждой попыткой)
CIRCUIT_BREAKER_BASE_DELAY_SEC=30

# Не входить если funding rate был аномально высоким менее N минут назад
FUNDING_SPIKE_LOOKBACK_MIN=60

# ══════════════════════════════════════════════════════════════════════════════
# ИНТЕРВАЛЫ ОПРОСА
# ══════════════════════════════════════════════════════════════════════════════

# Интервал сканирования funding rates (секунды)
SCAN_INTERVAL_SEC=30

# Интервал мониторинга открытых позиций (секунды)
MONITOR_INTERVAL_SEC=15
MAX_NET_LOSS_PCT=0.005
TAKE_PROFIT_CONFIRMATION_INTERVALS=2

# ══════════════════════════════════════════════════════════════════════════════
# ЗАВЕРШЕНИЕ РАБОТЫ
# ══════════════════════════════════════════════════════════════════════════════

# close_positions = немедленно закрыть все позиции по рынку (выбрано)
# save_state      = сохранить состояние, позиции живут до следующего запуска
SHUTDOWN_MODE=close_positions

# Таймаут ожидания закрытия позиций при shutdown (секунды)
SHUTDOWN_TIMEOUT_SEC=30

# ══════════════════════════════════════════════════════════════════════════════
# ПЕРСИСТЕНТНОСТЬ
# ══════════════════════════════════════════════════════════════════════════════
SQLITE_PATH=data/arb.db

# ══════════════════════════════════════════════════════════════════════════════
# TELEGRAM УВЕДОМЛЕНИЯ
# ══════════════════════════════════════════════════════════════════════════════
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Уровень уведомлений: all | trades_only | errors_only
TELEGRAM_LEVEL=trades_only

# ── Логирование ───────────────────────────────────────────────────────────────
# debug | info | warning | error
LOG_LEVEL=info
# json | console
LOG_FORMAT=json
LOG_FILE=logs/arb.log

# Pause re-entry for the same symbol after a full close (all exchange pairs).
REENTRY_COOLDOWN_SEC=1800

# Carry v2: conservative forecast from synchronized, persisted 5-minute observations.
# History confirms direction; forecast horizon follows EXPECTED_HOLD_HOURS and MAX_HOLD_HOURS.
FUNDING_HISTORY_MIN_HOURS=1
FUNDING_HISTORY_WINDOW_HOURS=24
FUNDING_HISTORY_BUCKET_SEC=300
FUNDING_FORECAST_DISCOUNT=0.75
MAX_FUNDING_AGE_SEC=7200
MAX_BOOK_AGE_SEC=30

# Ordinary low-funding exits require close PnL or bounded recovery economics.
# Emergency stops and unavailable data bypass minimum holding time.
MIN_SOFT_HOLD_HOURS=1
NEGATIVE_FUNDING_EXIT_SEC=900
MAX_RECOVERY_HOURS=8
EXIT_PROFIT_BUFFER_PCT=0.0001
TAKE_PROFIT_PCT=0.0004
TRAILING_PROFIT_ACTIVATION_PCT=0.00025
TRAILING_PROFIT_GIVEBACK_PCT=0.25
EXIT_FUNDING_SPIKE_MULTIPLIER=5
MAX_NET_LOSS_PCT=0.01

# Two losses in the same directional venue pair within 48h: 24h entry pause.
PAIR_LOSS_LIMIT=2
PAIR_LOSS_LOOKBACK_HOURS=48
PAIR_LOSS_COOLDOWN_SEC=86400

# Aster V3: public USDT perpetuals, no API key needed for paper mode.
ASTER_ENABLED=true
ASTER_REST_URL=https://fapi.asterdex.com
ASTER_MAKER_FEE=0
ASTER_TAKER_FEE=0.0004
ASTER_GROUP_B_TAKER_FEE=0.001
ASTER_RWA_TAKER_FEE=0.000125

# Recent rate estimation window; signed warmup is configured separately.
FUNDING_FORECAST_WINDOW_HOURS=2
